{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2020",
    "lib": ["ES2020"],
    "types": ["node", "express", "nodemailer"],

    /* Modules */
    "module": "commonjs",
    "rootDir": "./src",
    "typeRoots": ["./node_modules/@types", "./src/types"],

    /* Emit */
    "outDir": "./dist",

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,

    /* Completeness */
    "skipLibCheck": true
  }
}
